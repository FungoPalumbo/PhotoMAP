<Window x:Class="PhotoMap.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informazioni su Fotomappa" Icon="Assets/app.ico" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="{DynamicResource BaseSize}" UseLayoutRounding="True">
    <StackPanel Margin="32,32,32,28">
        <Grid Width="56" Height="56" HorizontalAlignment="Left">
            <Ellipse Fill="{DynamicResource BrandFill}" Stroke="{DynamicResource BrandStroke}" StrokeThickness="2"/>
            <Viewbox Width="34" Height="34">
                <Path Fill="{DynamicResource BrandGlyph}" Data="M12,2 C8.1,2 5,5.1 5,9 C5,14.25 12,22 12,22 C12,22 19,14.25 19,9 C19,5.1 15.9,2 12,2 Z M12,11.8 A2.8,2.8 0 1 1 12,6.2 A2.8,2.8 0 0 1 12,11.8 Z"/>
            </Viewbox>
        </Grid>
        <TextBlock Text="Fotomappa" FontSize="{DynamicResource SizeH1}" FontFamily="{DynamicResource FontHead}" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
        <TextBlock Text="Visualizza le tue fotografie su una mappa, leggendo la posizione dai dati GPS."
                   TextWrapping="Wrap" Margin="0,16,0,0"/>
        <TextBlock Text="Autore" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,20,0,0"/>
        <TextBlock Text="Furyo Biagioni"/>
        <TextBlock Text="Mappe © contributori di OpenStreetMap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,20,0,0"/>
        <Button Style="{StaticResource PrimaryButton}" Content="Chiudi" HorizontalAlignment="Right" Margin="0,20,0,0" IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
